# AIOF Environment Configuration

# Gemini API Key (required for LLM reasoning/routing)
GEMINI_API_KEY=

# Persistence Layer: PostgreSQL with pgvector (leave empty or set AIOF_EPHEMERAL=true for ephemeral testing)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiof?sslmode=disable
# AIOF_EPHEMERAL=true

# Server Networking
AIOF_LISTEN_ADDR=0.0.0.0:8080

# SGLang & KV Cache Acceleration
# ENABLE_SGLANG=true
SGLANG_SOCKET_PATH=/tmp/sglang.sock
# LMCACHE_REDIS_URL=redis://localhost:6379/0

# Ingestion & RouteLLM Classifier
AIOF_ENABLE_INGESTION=false
ROUTE_LLM_WEIGHTS_PATH=config/route_llm_weights.json
